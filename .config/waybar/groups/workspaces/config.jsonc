{
    "group/group-workspaces": {
        "orientation": "horizontal",
        "modules": [
            "sway/workspaces#custom",
            "sway/scratchpad"
        ]
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "sway/workspaces#custom": {
        "disable-scroll": true,
        "all-outputs": true,
        "persistent-workspaces": {},
        "format": "{name}",
        "format-icons": {
            "high-priority-named": [ "10" ],
            "10": "0",
            "urgent": "",
            "focused": "",
            //"default": "",
            "empty": ""
        }
    }
}

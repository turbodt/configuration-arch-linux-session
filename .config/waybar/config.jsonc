{
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],

    "modules-right": [
        "custom/dropbox",
        "sway/language",
        "pulseaudio",
        "battery",
        "power-profiles-daemon",
        "network",
        "clock",
        "custom/suspend"
    ],

    "custom/dropbox": {
        "exec": "~/.config/waybar/scripts/dropbox-status",
        "return-type": "json",
        "interval": 10,
        "tooltip": true
    },

    "sway/language": {
        "format": "{shortDescription} ({variant})",
        "tooltip-format": "{long}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Perfil energètic: {profile}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },

    "custom/suspend": {
        "format": "⏾",
        "tooltip-format": "Suspendre",
        "on-click": "sh -c 'swaylock -f && systemctl suspend'"
    }
}

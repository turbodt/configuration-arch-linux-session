{
    "layer": "top",
    "position": "top",
    "include": [
        "./groups/actions/config.jsonc",
        "./groups/connectivity/config.jsonc",
        "./groups/power/config.jsonc",
        "./groups/state/config.jsonc",
        "./groups/sound/config.jsonc",
        "./groups/workspaces/config.jsonc"
    ],

    "modules-left": [
        "sway/mode",
        "group/group-workspaces"
    ],

    "modules-center": [
        "group/group-state"
    ],

    "modules-right": [
        "group/group-sound",
        "group/group-power",
        "group/group-connectivity",
        "group/group-actions"
    ],

    "tray": {
        "icon-size": 20,
        "spacing": 10
    },

    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", ""]
    }
}

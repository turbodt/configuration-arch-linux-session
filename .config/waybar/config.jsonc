{
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],

    "modules-right": [
        "custom/dropbox",
        "sway/language",
        "pulseaudio",
        "battery",
        "network",
        "clock"
    ],

    "custom/dropbox": {
        "exec": "~/.config/waybar/scripts/dropbox-status",
        "return-type": "json",
        "interval": 10,
        "tooltip": true,
        "on-click": "foot -e dropbox-cli status",
        "on-click-right": "xdg-open https://www.dropbox.com/home"
    },

    "sway/language": {
        "format": "{shortDescription} ({variant})",
        "tooltip-format": "{long}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    }
}
